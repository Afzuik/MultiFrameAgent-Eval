{
  "version": "1.0",
  "note": "AgentEval 工具注册表与确定性 fixture 数据。mock 服务、任务集、verifier 必须与此文件保持一致。价格单位统一为分(cent)。",
  "tools": {
    "travel": [
      {
        "name": "search_flights",
        "description": "按日期与起降地查询航班。date 必须为 ISO 格式(YYYY-MM-DD)，机场必须为大写三字码。返回该航线上所有固定航班。",
        "parameters": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "出发日期，ISO 格式如 2026-10-12" },
            "from": { "type": "string", "description": "出发机场三字码，如 PEK" },
            "to": { "type": "string", "description": "到达机场三字码，如 SHA" },
            "class": { "type": "string", "enum": ["economy", "business"], "description": "可选，舱位筛选" }
          },
          "required": ["date", "from", "to"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "get_user_profile",
        "description": "查询用户资料（姓名、VIP、身份验证状态）。",
        "parameters": {
          "type": "object",
          "properties": { "user_id": { "type": "string" } },
          "required": ["user_id"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "list_reservations",
        "description": "列出某用户的全部预订（含预订号、航班、日期、状态）。",
        "parameters": {
          "type": "object",
          "properties": { "user_id": { "type": "string" } },
          "required": ["user_id"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "verify_identity",
        "description": "验证用户身份。验证码固定为 1234（演示环境）。验证成功前，退款类工具将被拒绝。",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "code": { "type": "string", "description": "验证码，演示环境固定为 1234" }
          },
          "required": ["user_id", "code"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "book_flight",
        "description": "预订航班并创建预订记录。要求航班存在且有剩余座位。",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "flight_id": { "type": "string" },
            "class": { "type": "string", "enum": ["economy", "business"] },
            "passenger_name": { "type": "string" }
          },
          "required": ["user_id", "flight_id", "class"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "cancel_reservation",
        "description": "取消预订（不改退款）。仅可取消本人未退款的已预订记录。",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "reservation_id": { "type": "string" }
          },
          "required": ["user_id", "reservation_id"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "refund_reservation",
        "description": "对预订退款。要求：本人预订 + 已完成身份验证。退款后状态变为 refunded。",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "reservation_id": { "type": "string" }
          },
          "required": ["user_id", "reservation_id"]
        },
        "permission": "requires_auth",
        "read_only": false
      }
    ],
    "shop": [
      {
        "name": "get_order_status",
        "description": "查询订单状态，返回订单完整信息（含商品、金额、状态、收货地址 address、物流单号 tracking、发票 invoice）。订单不存在时返回 not_found。",
        "parameters": {
          "type": "object",
          "properties": { "order_id": { "type": "string" } },
          "required": ["order_id"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "list_orders",
        "description": "列出某用户的全部订单（订单号、商品、金额、状态、下单日期）。",
        "parameters": {
          "type": "object",
          "properties": { "user_id": { "type": "string" } },
          "required": ["user_id"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "update_address",
        "description": "修改订单收货地址。仅 paid 状态订单可修改，shipped/delivered 订单拒绝。地址长度必须 ≥ 10 字符。",
        "parameters": {
          "type": "object",
          "properties": {
            "order_id": { "type": "string" },
            "new_address": { "type": "string" }
          },
          "required": ["order_id", "new_address"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "verify_identity",
        "description": "验证用户身份。验证码固定为 1234（演示环境）。退款前必须完成验证。",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "code": { "type": "string", "description": "验证码，演示环境固定为 1234" }
          },
          "required": ["user_id", "code"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "apply_refund",
        "description": "申请退款。要求：订单属于当前已验证用户，且状态为 paid/shipped/delivered。他人订单返回权限错误。",
        "parameters": {
          "type": "object",
          "properties": {
            "order_id": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["order_id"]
        },
        "permission": "requires_auth",
        "read_only": false
      },
      {
        "name": "create_invoice",
        "description": "为订单补开发票。要求订单状态为 paid/delivered。返回发票抬头与金额。",
        "parameters": {
          "type": "object",
          "properties": {
            "order_id": { "type": "string" },
            "title": { "type": "string", "description": "发票抬头" }
          },
          "required": ["order_id", "title"]
        },
        "permission": "none",
        "read_only": false
      }
    ],
    "analytics": [
      {
        "name": "get_schema",
        "description": "查看数据表结构（表名与列名）。不传 table 时返回全部表。",
        "parameters": {
          "type": "object",
          "properties": { "table": { "type": "string", "description": "可选，sales/products/regions" } },
          "required": []
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "run_query",
        "description": "执行只读 SQL 查询。支持 SELECT/WHERE(AND)/GROUP BY/COUNT/SUM/BETWEEN。仅可查询 sales/products/regions 三张表。",
        "parameters": {
          "type": "object",
          "properties": { "sql": { "type": "string" } },
          "required": ["sql"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "export_report",
        "description": "将分析内容导出为报告（按标题存储）。返回 report_id。",
        "parameters": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["title", "content"]
        },
        "permission": "none",
        "read_only": false
      },
      {
        "name": "get_report",
        "description": "按标题读取已导出的报告。",
        "parameters": {
          "type": "object",
          "properties": { "report_id": { "type": "string" } },
          "required": ["report_id"]
        },
        "permission": "none",
        "read_only": true
      },
      {
        "name": "list_reports",
        "description": "列出全部已导出的报告。",
        "parameters": { "type": "object", "properties": {}, "required": [] },
        "permission": "none",
        "read_only": true
      }
    ]
  },
